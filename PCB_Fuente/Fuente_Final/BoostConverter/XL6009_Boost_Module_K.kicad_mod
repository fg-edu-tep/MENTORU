
(module XL6009_Boost_Module_KISS (layer F.Cu) (tedit 64400000)
  (descr "Simplified 4-pin boost converter footprint, 40.5mm x 17mm")
  (tags "XL6009 boost module KISS")
  (attr through_hole)

  (fp_text reference U? (at 0 -10) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value XL6009_Boost_Module (at 0 10) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15))))

  (pad 1 thru_hole rect (at -20.25 -8.50) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at -20.25 8.50) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at 20.25 8.50) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad 4 thru_hole circle (at 20.25 -8.50) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))

  (fp_text user "IN+" (at -20.25 -10.50) (layer F.SilkS) (effects (font (size 1 1))))
  (fp_text user "IN-" (at -20.25 10.50) (layer F.SilkS) (effects (font (size 1 1))))
  (fp_text user "OUT-" (at 20.25 10.50) (layer F.SilkS) (effects (font (size 1 1))))
  (fp_text user "OUT+" (at 20.25 -10.50) (layer F.SilkS) (effects (font (size 1 1))))
)
